{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000/v1",
        "EXPO_PUBLIC_WS_URL": "http://10.0.2.2:4000",
        "EXPO_PUBLIC_DIAGNOSTICS": "1"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.chapus.es/v1",
        "EXPO_PUBLIC_WS_URL": "https://staging-api.chapus.es",
        "EXPO_PUBLIC_DIAGNOSTICS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.chapus.es/v1",
        "EXPO_PUBLIC_WS_URL": "https://api.chapus.es"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
