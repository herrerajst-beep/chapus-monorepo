{
  "expo": {
    "name": "Chapus Pro",
    "slug": "chapus-proveedor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "es.chapus.proveedor",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "es.chapus.proveedor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "chapus_urgent_jobs",
          "sounds": [
            "./assets/sounds/urgent_alert.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chapus Pro usa tu ubicación para enviarte trabajos cercanos mientras estás disponible."
        }
      ]
    ],
    "scheme": "chapuspro",
    "experiments": {
      "typedRoutes": true
    }
  }
}
